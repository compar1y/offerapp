{
  "name": "offerapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode preview",
    "prebuild": "tsx scripts/catalog-images.ts",
    "build": "tsc -b && vite build && node scripts/verify-prod-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "test:calc": "tsx server/test/calc.ts",
    "test:api": "tsx server/test/calc.ts && tsx server/test/smoke.ts",
    "calc:gen": "node scripts/gen-receitas-custo.mjs",
    "checkouts:gen": "tsx scripts/gen-checkouts.ts",
    "checklist:gen": "tsx scripts/gen-checklist.ts",
    "comunicacao:gen": "tsx scripts/gen-comunicacao.ts",
    "upload:files": "tsx scripts/upload-blob.ts",
    "check:files": "tsx scripts/check-files.ts",
    "catalogo:imagens": "tsx scripts/catalog-images.ts",
    "dev:api": "tsx scripts/dev-api.ts",
    "check": "npm run lint && npm run typecheck:api && npm run test:api && npm run build && npm run build:preview -- --outDir dist-preview --emptyOutDir && rm -rf dist-preview",
    "dev:server": "vite",
    "build:preview": "tsc -b && vite build --mode preview"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
