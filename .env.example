# Copie para .env.local (NÃO versionado) e preencha. Aqui só nomes e instruções, nunca valores reais.
# Gerar segredo: openssl rand -hex 32

# ---- modo do app
# Não há variável de modo: `npm run build` = produção (servidor, sem demo); `npm run build:preview` = prévia com demonstração.

# ---- segredos do servidor
SESSION_SECRET=
FILE_SIGNING_SECRET=
# token que você cadastra na Wiapy (vai no header Authorization) e token do painel admin
WIAPY_WEBHOOK_TOKEN=
ADMIN_TOKEN=

# ---- armazenamento de dados (escolha um)
# Produção: Upstash Redis / Vercel KV (API REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Desenvolvimento local (sem KV): arquivo JSON, ignorado pelo git
# DATA_FILE=.data/db.json

# ---- arquivos pagos (escolha um). NUNCA em public/
# Desenvolvimento local: pasta fora de public (ex.: ../pdfs-app)
# FILES_DIR=../pdfs-app
# Produção: Vercel Blob PRIVADO
# FILES_BACKEND=blob
BLOB_READ_WRITE_TOKEN=
# validade da URL assinada do arquivo, em segundos (30 a 1800)
FILE_URL_TTL_SEC=300

# ---- e-mail do código de acesso (Resend)
RESEND_API_KEY=
MAIL_FROM=
# só desenvolvimento: imprime o código no terminal em vez de enviar e-mail
# DEV_LOG_CODES=1

# ---- opcional
# guarda os corpos do webhook SEM dados pessoais para conferir o formato real na primeira venda de teste
# WEBHOOK_LOG_RAW=1

# ---- kit completo (único ticket R$ 37,90)
# checkouts que liberam o kit quando payment.status = paid (separados por vírgula).
# Vazio = padrão: r2PHgYwK6CVi (código público) e 6accaf7eb11ba1ecaf89b37e (id interno do mesmo checkout).
# Qualquer outro checkout é ignorado (fica só registrado nos eventos).
# FULL_KIT_CHECKOUT_IDS=r2PHgYwK6CVi
# checagem extra opcional: 1 = só libera se o valor do checkout for exatamente 3790 centavos
# FULL_KIT_REQUIRE_AMOUNT=1

# ---- bump (Fichas de Socorro, R$ 7,90) por cliente
# ids exatos OU trechos de título (separados por vírgula) que contam como o bump dentro de um pedido. Vazio = padrão do catálogo.
# BUMP_ORDERBUMP_IDS=
# valores de apoio em centavos: só o kit (padrão 3790) e kit + bump (padrão 4580)
# FULL_KIT_AMOUNT_CENTS=3790
# BUMP_TOTAL_CENTS=4580

# ---- catálogo de ofertas (build do front, NÃO é segredo)
# O catálogo (/catalogo, /caminho, "Biblioteca completa") fica DESLIGADO em produção até o Levi mandar.
# Na prévia ele já aparece. Para ligar em produção: true.
VITE_CATALOG_ENABLED=false
# mínimo de itens prontos (ready:true em public/checkouts.json) para o botão de compra da Biblioteca completa (padrão 10)
# VITE_COMBO_MIN_AVAILABLE=10

# ---- links de compra e "pronto" (lidos pelo servidor; o app lê o mesmo arquivo pelo navegador)
# caminho do arquivo (padrão public/checkouts.json) e cache em ms (padrão 30000; 0 = sempre relê)
# CHECKOUTS_FILE=public/checkouts.json
# CHECKOUTS_CACHE_MS=30000
